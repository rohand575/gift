# Copy to .env.local and fill in from your Supabase project settings.
# These are PUBLIC by design (anon key is safe in the client; Row Level Security
# and security-definer RPC functions are what actually protect the data).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: set to '/' when deploying to a custom domain instead of a GitHub
# Pages project subpath. Leave unset for https://<user>.github.io/<repo>/.
# VITE_BASE=/gift/
